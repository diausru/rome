{
 "fps": 30,
 "lead": 0.8,
 "tail": 2.0,
 "footer": "Sources: CRA \u2014 Disability tax credit pages (eligibility, how to apply, review, decision, claiming) \u00b7 CRA tax tip June 16 2026 \u00b7 General info, not advice",
 "data": {
